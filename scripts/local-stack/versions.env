# Pinned images and ports. Everything binds to 127.0.0.1 only.
PG_IMAGE=public.ecr.aws/docker/library/postgres:16-alpine
AUTH_IMAGE=public.ecr.aws/supabase/gotrue:v2.170.0
REST_IMAGE=public.ecr.aws/supabase/postgrest:v12.2.12
PG_PORT=54999
AUTH_PORT=54321
REST_PORT=54322
GATEWAY_PORT=54320
LLM_STUB_PORT=54330
APP_PORT=3100
# Docker objects. Every container and the network carry this label; down.sh removes only objects that have it.
LS_LABEL=com.modaafa.local-stack=true
LS_NET=modaafa-ls-net
LS_PG=modaafa-ls-postgres
LS_AUTH=modaafa-ls-auth
LS_REST=modaafa-ls-rest
