    "clsx": "^2.1.1",
    "google-ads-api": "^17.1.0",
    "google-auth-library": "^9.14.1",
    "lucide-react": "^0.453.0",
    "next": "16.2.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stripe": "^17.2.0",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.5.4",
    "eslint": "^8.57.1",
