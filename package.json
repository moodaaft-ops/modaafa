{
  "name": "modaafa",
  "version": "0.1.0",
  "private": true,
  "description": "Modaafa - AI-powered Google Ads management platform",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
