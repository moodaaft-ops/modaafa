# Public application
NEXT_PUBLIC_APP_URL=https://ai.modaafa.com

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Used only by scripts/migrate.mjs. Keep it out of browser-exposed variables.
SUPABASE_DB_URL=

# Google login and Google Ads OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_LOGIN_REDIRECT_URI=https://ai.modaafa.com/api/auth/google/callback
GOOGLE_OAUTH_REDIRECT_URI=https://ai.modaafa.com/api/auth/google-ads/callback
GOOGLE_OAUTH_APP_VERIFIED=false

# Google Ads API
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_MCC_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_MANAGER_CUSTOMER_ID=
MOODAAFT_MANAGER_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v22

# Encryption and scheduled jobs
ENCRYPTION_KEY=
# Read-only fallback used temporarily while rotating ENCRYPTION_KEY.
ENCRYPTION_KEY_PREVIOUS=
CRON_SECRET=
# Separate read-only credential for the detailed /api/health response. Never
# reuse CRON_SECRET, which authorizes scheduled production work.
HEALTH_SECRET=
# Readiness capacity uses these conservative per-account time estimates. Tune
# them from production job_runs observations; they do not change job behavior.
CRON_SYNC_ESTIMATED_ACCOUNT_SECONDS=12
CRON_OPTIMIZE_ESTIMATED_ACCOUNT_SECONDS=45

# Autopilot live mutations are disabled by default. Keep this false until the
# migration is applied, observe mode has completed its soak period, and one
# isolated account has passed validate-only plus a supervised live test.
AUTOPILOT_EXECUTION_ENABLED=false

# Comma-separated authenticated operator emails. Operators can see launch
# readiness and test paid features with bounded Pro limits without Stripe.
MODAAFA_OPERATOR_EMAILS=

# Anthropic. Sonnet 5 is the default workhorse; overrides remain optional.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_OPUS=
ANTHROPIC_MODEL_SONNET=claude-sonnet-5
ANTHROPIC_MODEL_HAIKU=
# The free audit is the only model call before a subscription starts. It runs on
# Sonnet by default; set opus to put it back on the top tier (sonnet, haiku also
# accepted). Only the audit reads this.
FREE_AUDIT_MODEL_TIER=

# Stripe Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Arabic in-platform checkout (/billing/pay). Off unless ARABIC_CHECKOUT_ENABLED=true
# AND the publishable key is set; otherwise the hosted Stripe Checkout is used.
# Use pk_test_ / sk_test_ on previews. The publishable key is public by design.
ARABIC_CHECKOUT_ENABLED=
# The page reads STRIPE_PUBLISHABLE_KEY (or NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY) on the server.
# On a Vercel Preview it is off unless both this and STRIPE_SECRET_KEY are test keys.
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_GROWTH_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

# Operational email
RESEND_API_KEY=
RESEND_FROM_EMAIL=
OPS_ALERT_EMAIL=
# Where replies to the sign-up follow-up email land (the email invites a reply).
WELCOME_REPLY_TO_EMAIL=
# Signs unsubscribe links. Optional: falls back to CRON_SECRET.
UNSUBSCRIBE_SECRET=
# Email lifecycle (journeys, weekly report, broadcasts: /api/cron/email-lifecycle,
# and the welcome sweep /api/cron/welcome-email, which does nothing while this is off).
# Ships off. A real run also needs EMAIL_LIFECYCLE_ACTIVATED_AT set in
# config/email-journeys.ts and the copy approved in lib/lifecycle/copy.ts.
# ?dry=1 plans without sending, even while this is false.
# Neither cron is scheduled by the migrations folder: the schedules are proposals
# in db/proposals/ (20261014_email_lifecycle_cron.sql, 20261012_welcome_email_cron.sql).
EMAIL_LIFECYCLE_ENABLED=false
# Signing secret of the Resend webhook (delivery, open, click, bounce events).
RESEND_WEBHOOK_SECRET=

# Morning guard (الحارس الصباحي): a rules-only daily check of every connected
# account, /api/cron/guard (02:30 UTC). Ships off: the route reads and sends nothing.
#   true       every billable account
#   operators  only owners in MODAAFA_OPERATOR_EMAILS or GUARD_ALLOWLIST
# The email itself stays unsent until the guard_alert text is approved in
# lib/lifecycle/copy.ts; findings are still recorded and shown on /home.
GUARD_ENABLED=false
GUARD_ALLOWLIST=

# NOTE: there is no STRIPE_PRICE_ID catch-all. Every plan/period slot above
# must be set explicitly — a shared default silently billed every plan at the
# same price while the readiness check reported nothing wrong.

# TikTok Pixel code (not a secret). Read on the server at request time; leave
# empty to turn the pixel off completely. Production: DAULSBJC77U2BHFHG39G
TIKTOK_PIXEL_ID=

# Voice assistant (Task 06). Off unless all three are set and the flag is "true".
# The key stays server-side only. Voice is a library voice, never a cloned one.
VOICE_ASSISTANT_ENABLED=false
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=rpGHcNQJvO8dFNNFNj1v
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# Voice caps (all optional, clamped). Daily turns never exceed the plan's assistant quota.
VOICE_TICKET_SECRET=
VOICE_PROVIDER=
VOICE_DAILY_TURNS=30
VOICE_SESSION_MAX_TURNS=12
VOICE_SESSION_MAX_SECONDS=600
VOICE_MAX_AUDIO_BYTES=1500000
VOICE_MAX_AUDIO_SECONDS=30
ELEVENLABS_STT_MODEL_ID=scribe_v2

# Chat-first entry (/start) ships dark. Set to "true" only after review.
CHAT_FIRST_ENTRY=false

# Lead-quality loop (smart WhatsApp link /w/<slug>, lead inbox /leads, offline
# conversion upload, tracking scan) ships dark. "true" = every merchant,
# "operators" = Modaafa operators plus LEAD_LOOP_ALLOWLIST (comma separated
# emails), anything else = off (routes answer 404, cron does nothing).
# Needs the migration db/migrations/20261020_lead_loop.sql applied first.
LEAD_LOOP_ENABLED=false
LEAD_LOOP_ALLOWLIST=

# Customer-service bot ("الدعم") ships dark. "true" shows the widget on the
# public pages and opens /api/support/chat; anything else leaves every WhatsApp
# button as it is. The public pages are built statically, so redeploy after
# changing it. SUPPORT_BOT_TIER picks the model: haiku (default), sonnet, opus.
SUPPORT_BOT_ENABLED=false
SUPPORT_BOT_TIER=haiku

# TikTok Events API (server side CompleteRegistration). Token: Events Manager,
# Settings, Generate Access Token. Without it only the browser pixel reports.
TIKTOK_EVENTS_API_TOKEN=
# Test Events code (Events Manager, Test Events tab). Leave EMPTY in production:
# while it is set, TikTok treats every server event as a test and ignores it
# for optimization.
TIKTOK_TEST_EVENT_CODE=

# Ad account provisioning, «افتحه لي» (plan 121). Ships dark.
# A registered user with no Google Ads account presses one button; the platform
# creates the account under a DEDICATED manager account (MCC), invites the user's
# email as admin and follows the invitation. The manager account must be a
# standalone one, NOT under the agency manager 756-114-1000 (the account ceiling
# is computed on the top manager). The migration db/migrations/20261015_account_provisioning.sql
# must be applied first, then an operator connects the manager's Google user from
# /operations/provisioning ("اربط حساب المدير").
#   off (default) | operators (Modaafa operators + allowlist) | true (everyone)
ACCOUNT_PROVISIONING=off
ACCOUNT_PROVISIONING_ALLOWLIST=
# The dedicated manager account id, 10 digits, no dashes. Empty keeps the WhatsApp buttons.
PROVISIONING_MCC_ID=
# After the invitation is accepted, release the account from the manager (frees one of
# its 50 slots). Leave false until the live test shows Google allows the unlink.
PROVISIONING_UNLINK_AFTER_ACCEPT=false

# Media-buyer extended actions: ad schedule, device/location bid modifiers, geo target type,
# network settings, shared negative lists, Google recommendation apply/dismiss, pause auto-apply,
# and the Jarvis get_google_recommendations tool. Off unless this is exactly "true".
EXTENDED_ACTIONS_ENABLED=false
# Campaign launcher: turns a builder draft into a PAUSED campaign built in one
# validated batch after the merchant approves the card "ابنِ الحملة موقوفة". A second
# card "شغّلها" enables it. Off by default; with it off nothing changes.
CAMPAIGN_LAUNCH_ENABLED=false
# Weekly and monthly media-buyer loops (GAP-144 items 23 to 46). Every switch is off unless it is exactly "true".
# With a switch off, the code it guards does not run: no extra Google Ads read, no extra database read, no extra prompt words.
# N-gram analysis of search terms: a compact block in the optimizer snapshot and the Jarvis get_ngram_analysis tool.
NGRAM_ENABLED=false
# The optimizer reads measured outcomes of the last 90 days, holds back a repeat of a change that measured negative,
# and measures new changes against untouched campaigns (difference in differences).
OUTCOME_MEMORY_ENABLED=false
# Saudi season calendar (Ramadan, Eids, National and Founding Day, White Friday, back to school) in the optimizer and the monthly session.
SEASONS_ENABLED=false
# Merchant-stated facts (offer, stock out, price change, busy hours) saved by Jarvis (save_merchant_context) and read by the loops.
# Needs db/migrations/20261020_merchant_context.sql applied first.
BUSINESS_MEMORY_ENABLED=false
# Monthly deep session on the Opus tier + Jarvis get_auction_insights / get_quality_score tools + monthly money report mail.
# The mail copy (monthly_report) stays approved:false in lib/lifecycle/copy.ts until Ayman reads it.
MONTHLY_REVIEW_ENABLED=false
# Monthly session limits (only read when MONTHLY_REVIEW_ENABLED=true). Defaults shown.
# Accounts that spent less than this in the month (account currency) get no session.
MONTHLY_REVIEW_MIN_SPEND=500
# Ceiling of ONE account's model call in USD, checked before the call from a worst-case bound.
MONTHLY_REVIEW_MAX_COST_USD=0.5
# Accounts per invocation; the rest are picked up by the next slot of the first three days of the month.
MONTHLY_REVIEW_MAX_ACCOUNTS=25
# The session may run on the first N days of the month (a missed slot is retried; a report is written once per month).
MONTHLY_REVIEW_CATCHUP_DAYS=3

# Ad copy and assets (media buyer): asset performance reader, Saudi-copy RSA writer, replace-LOW-assets,
# sitelinks/callouts/snippet/call assets, ad tests, Jarvis get_ad_assets, and optimizer cards for them.
# Write actions also need EXTENDED_ACTIONS_ENABLED=true. Off unless this is exactly "true".
ADS_STUDIO_ENABLED=false
# --- Media buyer upgrade: trust and autonomy (all default OFF) ---------------
# Weekly landing page check per account (migration 20261020_trust_landing_checks.sql).
# Fetches the ad final URLs from our servers (https only, public IPs only) and
# adds the Jarvis tool get_landing_check.
LANDING_CHECK_ENABLED=false
# Adds the Jarvis tool get_response_coaching (offer and response problems that
# sit outside the ad account). Rules only, no model call.
OFFER_COACHING_ENABLED=false
# Two autonomy levels in the autopilot settings page (migration
# 20261020_trust_autonomy_levels.sql). Still requires AUTOPILOT_EXECUTION_ENABLED=true.
AUTONOMY_LEVELS_ENABLED=false
# Horizontal expansion ideas on the optimizer page (new ad group, new campaign type;
# new geo needs a geo read that is not wired yet). Recommendation only, opens the assistant.
EXPANSION_IDEAS_ENABLED=false
# The card «خلّ فريق مُضاعفة يمسكه» and the /operations/handoff tab
# (migration 20261020_trust_agency_handoff.sql). Thresholds: lib/landing/owner-config.ts.
AGENCY_HANDOFF_ENABLED=false
# Operator-only shadow accounts and /operations/shadow
# (migration 20261020_trust_shadow_mode.sql). A shadow account is never executed on.
SHADOW_MODE_ENABLED=false
